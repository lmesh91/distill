{
	"name": "distill",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"relay": "node relay/server.ts",
		"test": "node --test relay/server.test.ts src/lib/lean/client.test.ts src/lib/server/lean.test.ts src/lib/levels/initialCode.test.ts src/lib/server/redirects.test.ts src/lib/server/progress.test.ts src/lib/server/levels.test.ts",
		"test:relay": "node --test relay/server.test.ts",
		"test:editor": "node --test src/lib/lean/client.test.ts",
		"test:submissions": "node --test src/lib/server/lean.test.ts",
        "test:initial-code": "node --test src/lib/levels/initialCode.test.ts",
        "test:redirects": "node --test src/lib/server/redirects.test.ts",
        "test:progress": "node --test src/lib/server/progress.test.ts",
        "test:levels": "node --test src/lib/server/levels.test.ts",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p relay/tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^24",
		"@types/ws": "^8.18.2",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"@codemirror/commands": "^6.11.1",
		"@codemirror/language": "^6.13.1",
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.14",
		"@clerk/backend": "^3.23.2",
		"mongodb": "^7.6.0",
		"svelte-clerk": "^1.1.15",
		"vscode-jsonrpc": "^9.0.3",
		"ws": "^8.22.0"
	}
}

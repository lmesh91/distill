import Distill.Informalizer.IR.Context
import Distill.Informalizer.Present.Unfold

/-!
# The definitions and theorems a proof uses

`referencedConstants ir` lists the constants a proof relies on, for a reader who wants to know
what they need to know to follow it, and for the coverage test, which checks that each has an
English name.

A constant is *direct* if it occurs in the statement, a goal, a hypothesis or the proof term. It
is *reached by unfolding* if it occurs in none of them, but Lean unfolded it to accept the proof:
`Set.Subset` for `intro x hx` on a goal `A ⊆ B`, `Set.Intersection` for `hx.left` with
`hx : x ∈ A ∩ B`. Those are found by type-checking each goal's assignment against the goal and
recording what the checker unfolds (`Present.unfoldedIn`), so the list does not depend on which
tactics produced the proof.

Left out: instances (which only say which `∈` or `⊆` is meant), constants Lean generated
(matchers, auxiliary lemmas, `sorryAx`), the binder annotations `outParam`, `optParam`, …, and anything that is not a constant, such as the
auto-bound type `α` of a statement.
-/

namespace Distill.Informalizer

open Lean Meta
open Distill.Informalizer.IR

/-- What kind of constant a referenced constant is. -/
inductive ConstantKind where
  | definition | «theorem» | «axiom» | type | constructor | other
  deriving Inhabited, BEq, Repr

def ConstantKind.describe : ConstantKind → String
  | .definition => "definition"
  | .theorem => "theorem"
  | .axiom => "axiom"
  | .type => "type"
  | .constructor => "constructor"
  | .other => "other"

/-- A constant a proof uses. -/
structure ReferencedConstant where
  name : Name
  kind : ConstantKind
  /-- Whether it occurs in a term of the proof; `false` if Lean only reached it by unfolding. -/
  direct : Bool
  deriving Inhabited, BEq, Repr

def constantKind (env : Environment) (n : Name) : ConstantKind :=
  match env.find? n with
  | some (.defnInfo _) | some (.opaqueInfo _) => .definition
  | some (.thmInfo _) => .theorem
  | some (.axiomInfo _) => .axiom
  | some (.inductInfo _) => .type
  | some (.ctorInfo _) => .constructor
  | _ => .other

/-- Whether a reader is told about `n`: not an instance, not generated by Lean. Class
projections (`Membership.mem`) and structure projections (`Set.mem`) are kept: they are the
notation and the fields the statement is written with. -/
def isReportedConstant (n : Name) : MetaM Bool := do
  let env ← getEnv
  if n.isInternal || n.hasMacroScopes || isPrivateName n then return false
  if n == ``sorryAx then return false
  -- Binder annotations that only guide elaboration (`outParam α` is `α`).
  if n == ``outParam || n == ``semiOutParam || n == ``optParam || n == ``autoParam then
    return false
  if ← isInstance n then return false
  if isMatcherCore env n || isAuxRecursor env n || isNoConfusion env n then return false
  if isRecCore env n then return false
  return env.contains n

/-- The constants occurring in the expressions of `ir`: the statement, every goal's target and
assignment, and every hypothesis's type and value. -/
def directConstants (ir : ProofIR) : MetaM (Array Name) := do
  let mut exprs : Array Expr := #[ir.statement.conclusion]
  for (_, h) in ir.hyps do
    exprs := exprs.push h.type
    if let some v := h.value? then exprs := exprs.push v
  for g in ir.goalOrder do
    let gi := ir.goals[g]!
    exprs := exprs.push gi.target
    if let some a := gi.assignment? then exprs := exprs.push a.proof
  let mut seen : NameSet := {}
  let mut out := #[]
  for e in exprs do
    -- A `sorry`'s arguments (its type, which is a goal already listed, and Lean's bookkeeping
    -- for the error message, with `Lean.Name` and `Bool`) are not part of the proof.
    let e := (← instantiateMVars e).replace fun s =>
      if s.isAppOf ``sorryAx then some (mkConst ``sorryAx) else none
    for n in e.getUsedConstants do
      unless seen.contains n do
        seen := seen.insert n
        out := out.push n
  return out

/-- The constants Lean unfolds to check each goal's assignment against the goal. A proof that
does not type-check (an error in the source) contributes what was unfolded before the failure. -/
def unfoldedConstants (ir : ProofIR) : MetaM (Array Name) := do
  let (_, names) ← Present.unfoldedIn do
    for g in ir.goalOrder do
      let gi := ir.goals[g]!
      let some a := gi.assignment? | continue
      ir.withGoalContext g do
        try
          Meta.check a.proof
          discard <| withNewMCtxDepth (isDefEq (← inferType a.proof) gi.target)
        catch _ => pure ()
  return names

/-- The definitions and theorems `ir` uses (see the module documentation): the direct ones in
the order they first occur, then the ones only reached by unfolding, alphabetically. -/
def referencedConstants (ir : ProofIR) : MetaM (Array ReferencedConstant) := ir.withContext do
  let env ← getEnv
  let direct ← directConstants ir
  let directSet : NameSet := direct.foldl (·.insert ·) {}
  let unfolded := (← unfoldedConstants ir).filter (!directSet.contains ·)
  let mut out := #[]
  for n in direct do
    if ← isReportedConstant n then
      out := out.push { name := n, kind := constantKind env n, direct := true }
  for n in unfolded do
    if ← isReportedConstant n then
      out := out.push { name := n, kind := constantKind env n, direct := false }
  return out

end Distill.Informalizer

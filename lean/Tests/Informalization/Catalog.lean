import Distill.Informalizer.Frontend
import Distill.Translate

/-! #103: the English of every catalog entry that is not held out (generated by
`scripts/informalization/catalog.py test`; the held-out entries in `Tests/HeldOut/` are never
read here). Each entry also states whether it meets what its kind requires:

* every kind: the pipeline does not fail, every proof has a statement that `verify` finds
  identical to the original, English for its proof (never a blank), and the presentation
  passes `verify` (a complete or an incomplete proof, never a failed check);
* `alternative` (a complete proof using demo constructs): moreover the proof verifies as
  complete and its English has no Lean code in it.
-/

open Lean Distill.Informalizer

unsafe def checkCatalogEntry (path : System.FilePath) : IO Unit := do
  let source ← IO.FS.readFile path
  let kind := (source.splitOn "
").findSome? (·.dropPrefix? "-- kind: " |>.map (·.toString))
    |>.getD "?"
  let (trees, _, _) ← Extract.elabSource source path.toString
  let mut problems : Array String := #[]
  let mut proofs := 0
  for tree in trees do
    for p in ← informalizeTree tree do
      proofs := proofs + 1
      IO.println s!"  {p.ir.decl.componentsRev.head!}"
      match p.english.statement? with
      | some st => IO.println s!"    {st.toMarkup}"
      | none => problems := problems.push "no statement"
      let text := p.english.proofText
      if text.toMarkup.trimAscii.isEmpty then problems := problems.push "no English for the proof"
      IO.println s!"    Proof. {text.toMarkup}"
      match p.verification? with
      | some v =>
        IO.println s!"    verify: {v.statement.describe}; {v.proof.describe}"
        unless v.statement matches .identical do problems := problems.push "statement changed"
        if let some reason := v.failure? then problems := problems.push s!"not verified: {reason}"
        if kind == "alternative" then
          unless v.proof matches .complete _ do problems := problems.push "proof not complete"
          if p.english.steps.any (·.text.leaves.any (· matches .code _)) then
            problems := problems.push "Lean code in the English"
      | none => problems := problems.push "not verified"
  if proofs == 0 then problems := problems.push "no proofs"
  IO.println s!"  {kind}: {if problems.isEmpty then "meets its kind's requirements" else ", ".intercalate problems.toList}"

